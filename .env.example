# Copy this file to .env for local testing (never commit the real .env).
# GMAIL_ADDRESS is both the sender and the recipient (send-to-self).
# GMAIL_APP_PASSWORD is a Google Account App Password, NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
